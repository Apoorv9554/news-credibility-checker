{
  "manifest_version": 3,
  "name": "News Credibility Checker",
  "version": "1.0.1",
  "description": "Analyze the current page for fake news, clickbait, and credibility using the local News Credibility Checker backend.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8010/*",
    "http://127.0.0.1:8001/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon.svg"
  },
  "action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html",
    "default_title": "News Credibility Checker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
